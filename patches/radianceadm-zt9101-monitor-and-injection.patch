diff --git a/src/os/linux/netdev/ndev_linux.c b/src/os/linux/netdev/ndev_linux.c
index f5a79a6..72b0145 100644
--- a/src/os/linux/netdev/ndev_linux.c
+++ b/src/os/linux/netdev/ndev_linux.c
@@ -22,6 +22,77 @@
 #include "hif.h"
 #include "rx.h"
 #include "common.h"
+
+#ifdef CFG_ENABLE_MONITOR_MODE
+/* Monitor-mode injection: the skb carries a radiotap header (as written by aireplay-ng,
+ * mdk4 and friends) followed by a raw 802.11 frame. Strip the radiotap header and hand the
+ * raw frame to the *real* management-frame TX path (zt_nic_mgmt_frame_xmit) -- the same one
+ * used for probe requests and auth/assoc frames. The chip does not care what subtype the
+ * 802.11 header says; it only needs the TX descriptor nic_mgmt_frame_xmit builds. This is
+ * the actual HIF path; cfg80211's Mgmt_Tx is a no-op outside P2P and cannot be reused.
+ * No ACK is requested (same as a probe request): injected frames are typically broadcast
+ * or expect no ACK to the attacker, and waiting here would stall the TX queue. */
+static void work_monitor_tx_entry(struct net_device *pnetdev, struct sk_buff *pkt)
+{
+    ndev_priv_st *ndev_priv = netdev_priv(pnetdev);
+    nic_info_st *pnic_info = ndev_priv->nic;
+    tx_info_st *ptx_info;
+    struct xmit_buf *pxmit_buf;
+    struct ieee80211_radiotap_header *prthdr;
+    zt_u16 rt_len;
+    zt_s32 frame_len;
+
+    if (pnic_info == NULL || pnic_info->tx_info == NULL || ZT_CANNOT_RUN(pnic_info))
+    {
+        goto drop;
+    }
+    if (pkt->len < sizeof(struct ieee80211_radiotap_header))
+    {
+        goto drop;
+    }
+    prthdr = (struct ieee80211_radiotap_header *)pkt->data;
+    if (prthdr->it_version != 0)
+    {
+        goto drop;
+    }
+    rt_len = zt_le16_to_cpu(prthdr->it_len);
+    if (rt_len < sizeof(struct ieee80211_radiotap_header) || rt_len > pkt->len)
+    {
+        goto drop;
+    }
+    frame_len = pkt->len - rt_len;
+    /* 10 bytes: shortest 802.11 frame the driver constructs elsewhere (CTS/ACK-class). */
+    if (frame_len < 10 || frame_len > (MAX_XMITBUF_SZ - TXDESC_OFFSET_NEW))
+    {
+        goto drop;
+    }
+
+    ptx_info = pnic_info->tx_info;
+    pxmit_buf = zt_xmit_extbuf_new(ptx_info);
+    if (pxmit_buf == NULL)
+    {
+        goto drop;
+    }
+
+    zt_memset(pxmit_buf->pbuf, 0, TXDESC_OFFSET_NEW);
+    zt_memcpy(pxmit_buf->pbuf + TXDESC_OFFSET_NEW, pkt->data + rt_len, frame_len);
+    pxmit_buf->pkt_len = (zt_u16)frame_len;
+
+    if (zt_nic_mgmt_frame_xmit(pnic_info, NULL, pxmit_buf, pxmit_buf->pkt_len) != 0)
+    {
+        LOG_W("monitor tx: frame submit failed, len=%d", frame_len);
+    }
+    /* zt_nic_mgmt_frame_xmit/zt_io_write_data owns pxmit_buf from here (freed on completion
+     * or, on the ZT_CANNOT_RUN early-out inside nic_mgmt_frame_xmit, immediately). The
+     * driver's own stats (ip -s link) come from tx_info/rx_info internal counters via
+     * ndev_get_stats, not from pnetdev->stats, so there is nothing useful to update there. */
+    zt_free_skb(pkt);
+    return;
+
+drop:
+    zt_free_skb(pkt);
+}
+#endif
 #ifdef CONFIG_IOCTL_CFG80211
 #include <linux/nl80211.h>
 #include <net/cfg80211.h>
@@ -450,7 +521,7 @@ static zt_s32 ndev_start_xmit(struct sk_buff *skb, struct net_device *ndev)
 #ifdef CFG_ENABLE_MONITOR_MODE
     if (zt_mlme_check_mode(ndev_priv->nic, ZT_MONITOR_MODE) == zt_true)
     {
-        //work_monitor_tx_entry(pnetdev, (struct sk_buff *)pkt);
+        work_monitor_tx_entry(ndev, skb);
     }
     else
 #endif
