diff --git a/src/os/linux/cfg80211/zt_cfg80211.c b/src/os/linux/cfg80211/zt_cfg80211.c
index 2637629..e6f41ce 100644
--- a/src/os/linux/cfg80211/zt_cfg80211.c
+++ b/src/os/linux/cfg80211/zt_cfg80211.c
@@ -25,6 +25,37 @@
 #include "zt_cfg80211.h"
 #include "android/android_priv_cmd.h"
 
+#ifdef CFG_ENABLE_MONITOR_MODE
+/* Monitor mode: open the chip's receive filter (RCR) so management, control and data frames
+ * of every BSSID reach the host. Uses the same MCU command as the factory-test RX filter. */
+#define ZT_MON_RCR_AAP   ZT_BIT(0)
+#define ZT_MON_RCR_APM   ZT_BIT(1)
+#define ZT_MON_RCR_AM    ZT_BIT(2)
+#define ZT_MON_RCR_AB    ZT_BIT(3)
+#define ZT_MON_RCR_ADF   ZT_BIT(11)
+#define ZT_MON_RCR_ACF   ZT_BIT(12)
+#define ZT_MON_RCR_AMF   ZT_BIT(13)
+#define ZT_MON_RCR_HTC   ZT_BIT(14)
+#define ZT_MON_RCR_PHYST ZT_BIT(28)
+static void zt_monitor_set_rx_filter(nic_info_st *pnic_info, zt_bool on)
+{
+    zt_u32 inbuff[3] = { 0 };
+
+    if (on)
+    {
+        inbuff[0] = 1;
+        inbuff[1] = ZT_MON_RCR_AAP | ZT_MON_RCR_APM | ZT_MON_RCR_AM | ZT_MON_RCR_AB |
+                    ZT_MON_RCR_ADF | ZT_MON_RCR_ACF | ZT_MON_RCR_AMF | ZT_MON_RCR_HTC |
+                    ZT_MON_RCR_PHYST;
+        inbuff[2] = zt_true;
+    }
+    if (mcu_cmd_communicate(pnic_info, UMSG_OPS_MP_SET_PRX, inbuff, 3, NULL, 0) == ZT_RETURN_FAIL)
+    {
+        LOG_W("monitor: set rx filter failed");
+    }
+}
+#endif
+
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0))
 #define ZT_STA_EVENT_DEV(ndev) ((ndev)->ieee80211_ptr)
 #else
@@ -1326,6 +1357,19 @@ static zt_s32 _cfg80211_change_iface(struct wiphy *wiphy,
     zt_memset(pnic_info->sec_info, 0, sizeof(sec_info_st));
     zt_local_cfg_set_work_mode(pnic_info, network_type);
     zt_mcu_set_op_mode(pnic_info, network_type);
+#ifdef CFG_ENABLE_MONITOR_MODE
+    if (network_type == ZT_MONITOR_MODE)
+    {
+        zt_monitor_set_rx_filter(pnic_info, zt_true);
+        /* The vendor driver ties the kernel netif TX queue state to "associated to an AP"
+         * (zt_os_api_disable_all_data_queue on disconnect stops all queues + drops carrier;
+         * nothing ever re-enables them for monitor mode, since monitor never associates).
+         * With queues left stopped, dev_queue_xmit's qdisc layer drops every injected frame
+         * before ndo_start_xmit is ever called -- independent of anything work_monitor_tx_entry
+         * does. Use the same helper the normal connect-success path uses to re-open them. */
+        zt_os_api_enable_all_data_queue(ndev);
+    }
+#endif
 
     return 0;
 }
@@ -3068,7 +3112,69 @@ static zt_s32 _set_monitor_channel(struct wiphy *wiphy
 #endif
                                   )
 {
+    nic_info_st *pnic_info = *((nic_info_st **)wiphy_priv(wiphy));
+    zt_s32 chan_offset = HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+    zt_s32 chan_width = CHANNEL_WIDTH_20;
+    zt_u8 chan_target;
 
+    if (pnic_info == NULL || chandef == NULL || chandef->chan == NULL)
+    {
+        return -EINVAL;
+    }
+    if (ZT_CANNOT_RUN(pnic_info))
+    {
+        return -EPERM;
+    }
+
+    chan_target = (zt_u8) ieee80211_frequency_to_channel(chandef->chan->center_freq);
+    if (chandef->width == NL80211_CHAN_WIDTH_40)
+    {
+        chan_width = CHANNEL_WIDTH_40;
+        chan_offset = (chandef->center_freq1 > chandef->chan->center_freq) ?
+                      HAL_PRIME_CHNL_OFFSET_LOWER : HAL_PRIME_CHNL_OFFSET_UPPER;
+    }
+
+    zt_hw_info_set_channel_bw(pnic_info, chan_target, chan_width, chan_offset);
+    pnic_info->mon_channel = chan_target;
+    return 0;
+}
+#endif
+
+/* Lets `iw dev <if> info` / aireplay-ng's "determine current channel" check read the
+ * channel back: without this op cfg80211 has nothing to report, which made aireplay-ng
+ * refuse to inject (it needs a channel != -1) even though TX itself was fine. */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0))
+static zt_s32 _get_channel(struct wiphy *wiphy, struct wireless_dev *wdev,
+                          unsigned int link_id, struct cfg80211_chan_def *chandef)
+{
+    nic_info_st *pnic_info = *((nic_info_st **)wiphy_priv(wiphy));
+    zt_u8 ch;
+
+    if (pnic_info == NULL || chandef == NULL)
+    {
+        return -EINVAL;
+    }
+
+    if (wdev && wdev->iftype == NL80211_IFTYPE_MONITOR && pnic_info->mon_channel)
+    {
+        ch = pnic_info->mon_channel;
+    }
+    else
+    {
+        ch = pnic_info->hw_ch ? *pnic_info->hw_ch : 0;
+    }
+    if (ch == 0)
+    {
+        return -ENODATA;
+    }
+
+    chandef->chan = ieee80211_get_channel(wiphy, zt_ch_2_freq((zt_s32)ch));
+    if (chandef->chan == NULL)
+    {
+        return -ENODATA;
+    }
+    chandef->width = NL80211_CHAN_WIDTH_20;
+    chandef->center_freq1 = chandef->chan->center_freq;
     return 0;
 }
 #endif
@@ -4285,6 +4391,9 @@ static struct cfg80211_ops zt_cfg80211_ops =
 
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 6, 0))
     .set_monitor_channel = _set_monitor_channel, //
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0))
+    .get_channel = _get_channel,
+#endif
 #endif
 
